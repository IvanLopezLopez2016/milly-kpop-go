@page "/admin/articulos/editar/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ADMIN")]
@using MudBlazor
<PageTitle>Editar artículo · Milly K-Pop GO</PageTitle>
<MudThemeProvider /><MudPopoverProvider /><MudDialogProvider /><MudSnackbarProvider />
<div class="milly-catalog-page"><div class="milly-catalog-head"><MudText Typo="Typo.h4">Editar artículo</MudText><MudButton Href="/admin/articulos" Variant="Variant.Outlined">Volver</MudButton></div>
@if (Error != null) { <MudAlert Severity="Severity.Error">@Error</MudAlert> }
else if (Cargando) { <MudProgressLinear Indeterminate="true" /> }
else if (Registro is not null) {
    <MudPaper Class="pa-4 milly-catalog-edit" Elevation="0">
      <form action="/admin/articulos/guardar" method="post" class="milly-catalog-form">
        <input type="hidden" name="__RequestVerificationToken" value="@Token" /><input type="hidden" name="id" value="@Id" />
        <label>Nombre *<input name="nombre" required minlength="2" maxlength="200" value="@Registro.Nombre" /></label>
        <label>SKU interno<input name="sku" maxlength="100" value="@Registro.Sku" /></label>
        <label>Código de barras<input name="codigo_barras" maxlength="150" value="@Registro.CodigoBarras" /></label>
        <label>Grupo / artista<input name="grupo" maxlength="120" value="@Registro.Grupo" /></label>
        <label>Variante<input name="variante" maxlength="160" value="@Registro.Variante" /></label>
        <label>Precio de referencia<input type="number" name="precio_referencia" min="0" step="0.01" value="@(Registro.PrecioReferencia?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" /></label>
        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">Guardar cambios</MudButton>
      </form>
      <form action="/admin/articulos/estado" method="post" class="mt-4">
        <input type="hidden" name="__RequestVerificationToken" value="@Token" /><input type="hidden" name="id" value="@Id" /><input type="hidden" name="activo" value="@(!Registro.Activo ? "true" : "false")" />
        <MudButton ButtonType="ButtonType.Submit" Color="Color.Warning" Variant="Variant.Outlined">@(Registro.Activo ? "Desactivar artículo" : "Reactivar artículo")</MudButton>
      </form>
    </MudPaper>
}</div>
