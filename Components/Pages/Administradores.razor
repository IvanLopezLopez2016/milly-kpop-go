@page "/admin/administradores"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ADMIN")]
@using MudBlazor


<style>
    .mi-estilo {
      color: #7042A1;
      font-size: 18px;
      background:#ede4fa;
      margin:30;
    }
    .go-container {
    background-color: #FFFFFF;
    border-radius: 20px;
    padding: 24px;
    border: 1px solid #F3E8FF;
    box-shadow: 0 6px 24px rgba(112, 66, 161, 0.08);
}
.go-button-center {
    display: block;
    width: fit-content;
    margin: 20px auto;
}
</style>

<PageTitle>Administradores · MILLY K-POP GO</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="my-6 mi-estilo go-container">
    @* <MudButton Href="/admin" Variant="Variant.Text" Color="Color.Primary">← Volver al menú principal</MudButton> *@
    <MudText Typo="Typo.h4" Class="mt-4 mb-2" >Administradores</MudText>
    <MudText Color="Color.Secondary" Class="mb-4">Crea un acceso adicional para administrar MILLY K-POP GO.</MudText>
    <MudPaper Elevation="1" Class="pa-5">
        <MudAlert Severity="Severity.Info" Class="mb-4">Esta cuenta tendrá los mismos permisos ADMIN que tú. Comparte la contraseña inicial únicamente con una persona de confianza.</MudAlert>
        <MudTextField T="string" Label="Correo electrónico" @bind-Value="Correo" InputType="InputType.Email" Variant="Variant.Outlined" Class="mb-3" Required="true" Disabled="@Guardando" />
        <MudTextField T="string" Label="Contraseña inicial" @bind-Value="Clave" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" Required="true" Disabled="@Guardando" HelperText="Mínimo 12 caracteres" />
        <MudTextField T="string" Label="Confirmar contraseña" @bind-Value="Confirmacion" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" Required="true" Disabled="@Guardando" />
        @if (Mensaje is not null)
        {
            <MudAlert Severity="@(Exito ? Severity.Success : Severity.Error)" Class="mb-3">@Mensaje</MudAlert>
        }
        <MudButton Color="Color.Primary"  class="go-button-center" Variant="Variant.Filled" Disabled="@Guardando" OnClick="CrearAsync">
            @(Guardando ? "Guardando..." : "Crear administrador")
        </MudButton>
    </MudPaper>
</MudContainer>
