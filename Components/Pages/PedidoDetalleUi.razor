@inherits PedidosCajasBase
@page "/admin/pedidos/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ADMIN")]
@using MudBlazor
<PageTitle>Detalle de pedido · Milly K-Pop GO</PageTitle>
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<section class="go84">
    <MudButton Href="/admin/pedidos" Variant="Variant.Text">Volver a pedidos</MudButton><MudText Typo="Typo.h4" Class="mb-3">Detalle del pedido</MudText>
    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error">@Error</MudAlert>
    }
    else if (Loading)
    {

        <MudProgressLinear Indeterminate="true" />
    }
    else if (Pedido is null)
    {

        <MudAlert Severity="Severity.Warning">No existe el pedido solicitado.</MudAlert>
    }
    else
    {

        <MudPaper Class="pa-4 mb-4" Elevation="0"><MudText Typo="Typo.h6">@View.Comprador(Pedido.CompradorId)</MudText><MudText Color="Color.Secondary">@Pedido.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText><MudText>@Pedido.NotaInterna</MudText></MudPaper><MudPaper Class="pa-4" Elevation="0">
        <MudTable Items="Items" Dense="true" Hover="true">
            <HeaderContent><MudTh>Artículo</MudTh><MudTh>Cantidad</MudTh><MudTh>Precio</MudTh><MudTh>Subtotal</MudTh><MudTh>Estado</MudTh><MudTh>Acciones</MudTh></HeaderContent><RowTemplate>
            <MudTd DataLabel="Artículo">@View.Articulo(context.ArticuloId)</MudTd><MudTd DataLabel="Cantidad">@context.Cantidad</MudTd><MudTd DataLabel="Precio">@Money(context.PrecioUnitario)</MudTd><MudTd DataLabel="Subtotal">@Money(context.Cantidad * context.PrecioUnitario)</MudTd><MudTd DataLabel="Estado">@context.Estado</MudTd><MudTd DataLabel="Acciones">
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => SolicitarEliminar(context))">Eliminar</MudButton>
        </MudTd>
    </RowTemplate>
</MudTable><MudText Typo="Typo.h6" Class="mt-3">Total: @Money(Total)</MudText>
</MudPaper>
}
</section>

<div class="go125-confirmacion">
    <MudDialog @bind-Visible="ConfirmarVisible">
        <DialogContent>
            <MudText Typo="Typo.h6">¿Eliminar este articulo?</MudText>
            <MudText>¿Deseas quitar <strong>@(ParaEliminar is null ? "el articulo" : View.Articulo(ParaEliminar.ArticuloId))</strong> de este pedido?</MudText>
            @if (ParaEliminar?.Estado == "PEDIDO")
            {
                <MudText Color="Color.Secondary">Como ya esta PEDIDO, pasara a Stock.</MudText>
            }
            @if (ParaEliminar?.Estado == "EN_ESPERA")
            {
                <MudText Color="Color.Secondary">Esta EN ESPERA, asi que no pasara a Stock.</MudText>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => ConfirmarVisible = false)" Variant="Variant.Text" Disabled="Procesando">Cancelar</MudButton>
            @if (ParaEliminar is not null)
            {
                <MudButton OnClick="Confirmar" Color="Color.Error" Variant="Variant.Filled" Disabled="Procesando">
                    @if (Procesando)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    }
                    Confirmar
                </MudButton>
            }
        </DialogActions>
    </MudDialog>
    <MudDialog @bind-Visible="AvisoVisible">
        <DialogContent>
            <MudText Typo="Typo.h6">Arti­culo con movimientos</MudText>
            <MudAlert Severity="Severity.Warning">No se puede eliminar este articulo: ya tiene cargos o pagos aplicados.</MudAlert>
            <MudText>Los abonos quedan retenidos en el historial de este arti­culo, no se devuelven ni se aplican a otros.</MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => AvisoVisible = false)" Variant="Variant.Text" Disabled="Procesando">Aceptar</MudButton>
            @if (DetalleMovimiento != Guid.Empty && ArticuloConMovimiento is not null)
            {
                <MudButton OnClick="ConfirmarConMovimientos" Color="Color.Primary" Variant="Variant.Filled" Disabled="Procesando">
                    @if (Procesando)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    }
                    @(ArticuloConMovimiento.Estado == "PEDIDO" ? "Pasar a Stock" : "Eliminar sin Stock")
                </MudButton>
            }
        </DialogActions>
    </MudDialog>
</div>
