@rendermode InteractiveServer
@using MudBlazor
@using MillyKpopGo.Catalogos

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-1">@Comprador.Nombre</MudText>
        @if (!string.IsNullOrWhiteSpace(Comprador.Correo))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@Comprador.Correo</MudText>
        }

        @if (!Comprador.AuthUserId.HasValue)
        {
            <MudAlert Severity="Severity.Warning" Class="my-2">Esta compradora todavía no tiene una cuenta vinculada, por lo que no es posible restablecer su contraseña.</MudAlert>
        }
        else if (!Comprador.Activo)
        {
            <MudAlert Severity="Severity.Warning" Class="my-2">Compradora inactiva. Reactívala antes de restablecer su contraseña.</MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Class="my-2">Genera una contraseña de 12 caracteres (solo minúsculas y números). Se muestra una sola vez; cópiala y compártela de forma privada por WhatsApp.</MudAlert>

            <MudTextField @bind-Value="Clave"
                          Label="Nueva contraseña"
                          Variant="Variant.Outlined"
                          ReadOnly="true"
                          Immediate="true"
                          Class="my-3"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Autorenew"
                          AdornmentColor="Color.Primary"
                          OnAdornmentClick="Generar"
                          AdornmentAriaLabel="Generar contraseña" />

            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Casino"
                       OnClick="Generar"
                       Disabled="_procesando">Generar contraseña</MudButton>

            @if (_resultado is { } msg)
            {
                <MudAlert Severity="@(_exito ? Severity.Success : Severity.Error)" Class="mt-3">@msg</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cerrar</MudButton>
        @if (Comprador.AuthUserId.HasValue && Comprador.Activo)
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="Aplicar"
                       Disabled="_procesando || string.IsNullOrEmpty(Clave) || _aplicada">
                @if (_procesando)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                }
                Restablecer contraseña
            </MudButton>
        }
    </DialogActions>
</MudDialog>
