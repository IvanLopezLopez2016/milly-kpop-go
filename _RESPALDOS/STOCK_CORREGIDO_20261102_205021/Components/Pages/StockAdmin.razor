@page "/admin/stock"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ADMIN")]
@using MudBlazor
<PageTitle>Artículos en Stock · Milly K-Pop GO</PageTitle>
<section class="pa-4">
    <MudText Typo="Typo.h4" Class="mb-3">Artículos en Stock</MudText>
    <MudButton Href="/admin" Variant="Variant.Text" Color="Color.Primary">Volver al panel</MudButton>
    @if (Resultado is "agregado" or "asignado")
    {
        <MudAlert Severity="Severity.Success">Operación realizada correctamente.</MudAlert>
    }
    @if (Resultado == "error")
    {
        <MudAlert Severity="Severity.Error">No se pudo realizar la operación. Verifica los datos y el stock disponible.</MudAlert>
    }
    @if (Resultado == "datos")
    {
        <MudAlert Severity="Severity.Warning">Revisa los datos ingresados.</MudAlert>
    }
    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error">@Error</MudAlert>
    }
    else if (Loading)
    {

        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="pa-4 my-4" Elevation="0">
            <MudText Typo="Typo.h6" Class="mb-2">Agregar artículo comprado por mí</MudText>
            <form method="post" action="/admin/stock/agregar" data-enhance="false">
                <AntiforgeryToken />
                <div class="go-stock-fields">
                    <label>Artículo <input name="nombre" required maxlength="250" /></label>
                    <label>Cantidad <input name="cantidad" type="number" required min="1" max="9999" value="1" /></label>
                    <label>Precio por unidad (MXN) <input name="precio" type="number" required min="0" step="0.01" value="0" /></label>
                    <label>Nota (opcional) <input name="nota" maxlength="500" /></label>
                </div>
                <!-- AQUÍ ESTÁ EL CAMBIO: Se añadieron d-block y mx-auto -->
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3 d-block mx-auto">Agregar a Stock</MudButton>
            </form>
        </MudPaper>
        <MudPaper Class="pa-4" Elevation="0">
            <MudText Typo="Typo.h6" Class="mb-3">Existencias</MudText>
            @if (!Vista.Articulos.Any())
            {
                <MudText>Aún no tienes artículos en Stock.</MudText>
            }
            @foreach (var item in Vista.Articulos)
            {
                <div class="go-stock-row">
                    <div><strong>@item.Nombre</strong><div>@Money(item.PrecioUnitario) · Disponibles: @item.CantidadDisponible</div><small>@(item.Origen == "CANCELACION" ? "Cancelación de pedido" : "Compra propia")</small></div>
                    @if (item.CantidadDisponible > 0)
                    {
                        <form method="post" action="/admin/stock/asignar" data-enhance="false">
                            <AntiforgeryToken />
                            <input type="hidden" name="stock_id" value="@item.Id" />
                            <label>
                                Compradora
                                <select name="comprador_id" required>
                                    <option value="">Selecciona una compradora</option>
                                    @foreach (var compradora in Vista.Compradores)
                                    {
                                        <option value="@compradora.Id">@compradora.Nombre</option>
                                    }
                                </select>
                            </label>
                            <label>Cantidad <input name="cantidad" type="number" value="1" min="1" max="@item.CantidadDisponible" required /></label>
                            <MudButton ButtonType="ButtonType.Submit" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Asignar a compradora</MudButton>
                        </form>
                    }
                </div>
            }
        </MudPaper>
    }
</section>
