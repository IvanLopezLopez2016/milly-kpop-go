@page "/admin/stock"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ADMIN")]
@using MudBlazor
@using MillyKpopGo.Stock

<PageTitle>Artículos en Stock · MILLY K-POP GO</PageTitle>

<section class="go-stock-admin pa-3">
    <div class="go-stock-heading">
        <div>
            <MudText Typo="Typo.overline" Class="go-stock-eyebrow">MILLY K-POP GO</MudText>
            <MudText Typo="Typo.h4" Class="go-stock-title">Artículos en Stock</MudText>
            <MudText Class="go-stock-subtitle">Administra tus existencias y asígnalas a tus compradoras.</MudText>
        </div>
        <MudButton Href="/admin" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Volver al panel</MudButton>
    </div>

    @if (Resultado is "agregado" or "asignado" or "eliminado")
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">@(Resultado == "eliminado" ? "Artículo retirado del Stock correctamente." : "Operación realizada correctamente.")</MudAlert>
    }
    @if (Resultado == "error")
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">No se pudo realizar la operación. Comprueba los datos e inténtalo de nuevo.</MudAlert>
    }
    @if (Resultado == "datos")
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">Revisa los datos ingresados.</MudAlert>
    }
    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error">@Error</MudAlert>
    }
    else if (Loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="go-stock-card pa-4 mb-4" Elevation="0">
            <div class="go-stock-card-heading">
                <MudText Typo="Typo.h6">Agregar artículo</MudText>
                <span class="go-stock-hint">Compra propia</span>
            </div>
            <form method="post" action="/admin/stock/agregar" data-enhance="false">
                <AntiforgeryToken />
                <div class="go-stock-fields">
                    <label>Artículo <input name="nombre" required maxlength="250" placeholder="Ej. Álbum TXT" /></label>
                    <label>Cantidad <input name="cantidad" type="number" required min="1" max="9999" value="1" /></label>
                    <label>Precio por unidad (MXN) <input name="precio" type="number" required min="0" step="0.01" value="0" /></label>
                    <label>Nota (opcional) <input name="nota" maxlength="500" placeholder="Observaciones" /></label>
                </div>
                <div class="go-stock-add-action">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">Agregar a Stock</MudButton>
                </div>
            </form>
        </MudPaper>

        <MudPaper Class="go-stock-card go-stock-table-card pa-4" Elevation="0">
            <div class="go-stock-card-heading">
                <MudText Typo="Typo.h6">Existencias disponibles</MudText>
                <span class="go-stock-count">@Vista.Articulos.Count(x => x.CantidadDisponible > 0) artículos</span>
            </div>
            @if (!Vista.Articulos.Any(x => x.CantidadDisponible > 0))
            {
                <MudText Class="go-stock-empty">No tienes artículos disponibles en Stock.</MudText>
            }
            else
            {
                <MudTable T="StockItem"
                          Items="@(Vista.Articulos.Where(x => x.CantidadDisponible > 0))"
                          Dense="true" Hover="true" Striped="false"
                          Breakpoint="Breakpoint.Sm" RowsPerPage="8"
                          Class="go-stock-table">
                    <HeaderContent>
                        <MudTh>Artículo</MudTh>
                        <MudTh>Origen</MudTh>
                        <MudTh>Disponibles</MudTh>
                        <MudTh>Precio</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Artículo">
                            <div class="go-stock-item-name">@context.Nombre</div>
                            @if (!string.IsNullOrWhiteSpace(context.Nota))
                            {
                                <div class="go-stock-item-note">@context.Nota</div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Origen">
                            <span class="go-stock-origin">@(context.Origen == "CANCELACION" ? "Cancelación" : "Compra propia")</span>
                        </MudTd>
                        <MudTd DataLabel="Disponibles"><span class="go-stock-quantity">@context.CantidadDisponible</span></MudTd>
                        <MudTd DataLabel="Precio"><span class="go-stock-price">@Money(context.PrecioUnitario)</span></MudTd>
                        <MudTd DataLabel="Acciones">
                            <div class="go-stock-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => AbrirAsignacion(context))">Asignar</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => AbrirEliminar(context))">Eliminar</MudButton>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="@(new int[] { 5, 8, 15 })" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    }
</section>

<MudDialog @bind-Visible="AsignarVisible">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Asignar a compradora</MudText>
        @if (ArticuloAsignar is not null)
        {
            <MudText Class="mb-3"><strong>@ArticuloAsignar.Nombre</strong> · @ArticuloAsignar.CantidadDisponible disponible(s)</MudText>
            <form id="go-stock-asignar-form" method="post" action="/admin/stock/asignar" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="stock_id" value="@ArticuloAsignar.Id" />
                <div class="go-stock-dialog-fields">
                    <label>Compradora
                        <select name="comprador_id" required>
                            <option value="">Selecciona una compradora</option>
                            @foreach (var compradora in Vista.Compradores)
                            {
                                <option value="@compradora.Id">@compradora.Nombre</option>
                            }
                        </select>
                    </label>
                    <label>Cantidad
                        <input name="cantidad" type="number" value="1" min="1" max="@ArticuloAsignar.CantidadDisponible" required />
                    </label>
                </div>
            </form>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CerrarAsignacion">Cancelar</MudButton>
        <button class="go-stock-dialog-submit" style="background:#7042A1;color:white;padding:9px 16px;border:0;border-radius:9px;font-weight:600;cursor:pointer" type="submit" form="go-stock-asignar-form" disabled="@(ArticuloAsignar is null)">Asignar artículo</button>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="EliminarVisible">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">¿Eliminar artículo de Stock?</MudText>
        @if (ArticuloEliminar is not null)
        {
            <MudText>Se retirarán las <strong>@ArticuloEliminar.CantidadDisponible unidad(es) disponibles</strong> de <strong>@ArticuloEliminar.Nombre</strong>.</MudText>
            <MudAlert Severity="Severity.Info" Class="mt-3">Esto no afecta productos ya asignados a compradoras ni borra el historial de cancelaciones.</MudAlert>
            <form id="go-stock-eliminar-form" method="post" action="/admin/stock/eliminar" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="stock_id" value="@ArticuloEliminar.Id" />
            </form>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CerrarEliminar">Cancelar</MudButton>
        <button class="go-stock-dialog-submit go-stock-dialog-delete" style="background:#B42353;color:white;padding:9px 16px;border:0;border-radius:9px;font-weight:600;cursor:pointer" type="submit" form="go-stock-eliminar-form" disabled="@(ArticuloEliminar is null)">Sí, eliminar</button>
    </DialogActions>
</MudDialog>
